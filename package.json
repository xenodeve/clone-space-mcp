{
  "name": "clone-space-mcp",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Archive a live web page so it replays offline with real motion, and an AI agent can read how it is built.",
  "module": "src/index.ts",
  "scripts": {
    "lint": "oxlint src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "mutate": "bun run scripts/mutate.ts",
    "ci:lock": "bun run scripts/ci-lock.ts",
    "metamorphic": "bun run scripts/metamorphic.ts",
    "test:browser": "node --test \"test/browser/**/*.browser.ts\"",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "verify": "bun run lint && bun run typecheck && bun test && bun run test:browser && bun run build",
    "mcp:call": "node scripts/mcp-call.ts",
    "inspect": "node scripts/inspect.ts",
    "mcp:serve": "node scripts/mcp-server.ts",
    "fixture:serve": "bun run scripts/fixture-serve.ts",
    "spike": "node scripts/spike-cdp.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "gsap": "^3.15.0",
    "oxlint": "latest",
    "playwright": "^1.62.0",
    "typescript": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
